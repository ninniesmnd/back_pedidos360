# =============================================================================
# Pedidos360 — Variables de Entorno para Despliegue Multi-Instancia (4 EC2)
# Copiar como .env en cada instancia EC2 según corresponda:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Instancia EC2 #3 (Central Kafka + Kafka UI + Kafka Admin)
# Comando: docker compose -f docker-compose.kafka.yml up -d --build
# -----------------------------------------------------------------------------
# IP privada/elástica de la Instancia EC2 #3 accesible por las Instancias #2 y #4
KAFKA_EXTERNAL_HOST=localhost
KAFKA_REPLICAS=3

# -----------------------------------------------------------------------------
# 2. Instancia EC2 #2 (Backend Principal: Pedidos, Ventas, RabbitMQ, PostgreSQL)
# Comando: docker compose -f docker-compose.yml up -d --build
# -----------------------------------------------------------------------------
# Reemplazar localhost por la IP de la Instancia EC2 #3 en producción
KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9093,localhost:9094

# Credenciales y cookie del clúster RabbitMQ y API Key interna entre servicios
RABBITMQ_ERLANG_COOKIE=pedidos360-cookie
RABBITMQ_USER=pedidos360
RABBITMQ_PASS=cambiar-esta-clave
INTERNAL_API_KEY=cambiar-clave-interna

# -----------------------------------------------------------------------------
# 3. Instancia EC2 #4 (Kafka Streaming)
# Comando: docker compose -f docker-compose.kafka-streaming.yml up -d --build
# -----------------------------------------------------------------------------
# Utiliza KAFKA_BOOTSTRAP_SERVERS y KAFKA_REPLICAS definidos arriba
